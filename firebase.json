{
  "firestore": {
    "rules": "firestore.rules",
    "database": "(default)",
    "location": "asia-south1"
  },
  "hosting": {
    "public": "www",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**/*.@(js|html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
